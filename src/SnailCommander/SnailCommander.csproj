<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SnailCommander</AssemblyName>
    <RootNamespace>SnailCommander</RootNamespace>
    <Version>0.6.0</Version>
    <ApplicationTitle>Snail Commander</ApplicationTitle>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SnailCommander.Core/SnailCommander.Core.csproj" />
    <None Include="../../samples/*.json" Link="samples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
